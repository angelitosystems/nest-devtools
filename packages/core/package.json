{
  "name": "@angelitosystems/devtools-core",
  "version": "0.1.1",
  "description": "Transport, request context, source-map resolution and metrics for NestJS DevTools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/angelitosystems/nest-devtools"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "bun test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@angelitosystems/devtools-protocol": "workspace:*",
    "@types/ws": "^8.5.13",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}