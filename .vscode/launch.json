{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run NestJS DevTools Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "NestJS DevTools: compile extension"
    }
  ]
}
